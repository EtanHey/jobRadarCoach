#!/usr/bin/env python3
import json
import os
from pathlib import Path
import re
import subprocess
import sys


def scheduler_status(root):
    try:
        result = subprocess.run(
            [sys.executable, str(root / 'scripts/pipeline_scheduler_status.py')],
            capture_output=True, text=True, timeout=15, check=False,
        )
        value = json.loads(result.stdout)
        state = value.get('state')
        if state not in {'healthy', 'running', 'failed', 'stale', 'stalled', 'unknown', 'disabled'}:
            raise ValueError('unknown scheduler state')
        reason = value.get('reason')
        detail = f' ({reason})' if isinstance(reason, str) and re.fullmatch(r'[A-Za-z][A-Za-z0-9]{0,63}', reason) else ''
        print(f'scheduler: {state}{detail}', flush=True)
        return 0 if result.returncode == 0 and state in {'healthy', 'running'} else 1
    except (OSError, subprocess.SubprocessError, ValueError, AttributeError):
        print('scheduler: unknown (StatusUnavailable)', flush=True)
        return 1


def main(argv):
    commands = {'run': 'up', 'down': 'down', 'status': 'status'}
    if not argv or argv[0] not in commands:
        print('usage: jrc {run [--qa]|down|status}', file=sys.stderr)
        return 2
    root = Path(__file__).resolve().parent
    target = root / 'run'
    arguments = [str(target), commands[argv[0]], *argv[1:]]
    if argv[0] == 'status':
        scheduled = scheduler_status(root)
        runtime = subprocess.call(arguments)
        return runtime or scheduled
    os.execv(target, arguments)
    return 0


if __name__ == '__main__':
    raise SystemExit(main(sys.argv[1:]))
