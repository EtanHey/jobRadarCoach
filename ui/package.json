{
  "name": "ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts && node --import tsx --test tests/client/*.test.ts",
    "test:auth-browser": "node --import tsx --test browser-tests/*.test.ts",
    "predev": "node scripts/build-map-worker.mjs",
    "prebuild": "node scripts/build-map-worker.mjs",
    "test:e2e": "sh e2e/cap.sh e2e/run-capped.mjs",
    "test:db:up": "node e2e/db/db.mjs up",
    "test:db:seed": "node e2e/db/db.mjs seed",
    "test:db:down": "node e2e/db/db.mjs down",
    "test:db": "sh e2e/cap.sh e2e/db/run-capped.mjs 3072 600",
    "test:ui-polish": "sh e2e/cap.sh browser-tests/ui-polish.mjs 3072 600"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@deck.gl/core": "^9.4.0",
